{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: FastAPI with Port Check",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/start_app.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
